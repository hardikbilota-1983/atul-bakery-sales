# Clover API credentials (never commit real values)
CLOVER_MERCHANT_ID=
CLOVER_API_TOKEN=
# Production US: https://api.clover.com
# Sandbox: https://apisandbox.dev.clover.com
CLOVER_BASE_URL=https://api.clover.com
CLOVER_STORE_NAME=Hillside
# Must match the store’s Clover timezone (Long Island = Eastern)
CLOVER_TIMEZONE=America/New_York
PORT=8787

# Weekly franchisor email report (Gmail SMTP — see docs/WEEKLY_REPORT.md)
REPORT_ENABLED=false
CRON_SECRET=change-me-to-a-long-random-string
GMAIL_USER=atulbakeryhillside@gmail.com
# Google App Password (not your normal Gmail password)
GMAIL_APP_PASSWORD=
REPORT_FROM=atulbakeryhillside@gmail.com
REPORT_TO=franchisor@example.com,owner@example.com
# Optional — defaults to dashboard watch categories if empty
REPORT_CATEGORIES=