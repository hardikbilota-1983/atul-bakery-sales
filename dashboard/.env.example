# Clover API credentials (never commit real values)
CLOVER_MERCHANT_ID=
CLOVER_API_TOKEN=
# Production US: https://api.clover.com
# Sandbox: https://apisandbox.dev.clover.com
CLOVER_BASE_URL=https://api.clover.com
CLOVER_STORE_NAME=Hillside
# Must match the store’s Clover timezone (Long Island = Eastern)
CLOVER_TIMEZONE=America/New_York
PORT=8787

# ── Auth (required for public deploy) ───────────────────────────────────────
# Long random string for signed session cookies
SESSION_SECRET=change-me-to-a-long-random-string
# Local username/password accounts (comma-separated user:password)
# Example: AUTH_USERS=owner:StrongPasswordHere,manager:AnotherPassword
AUTH_USERS=
# Google OAuth (optional — create at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI in Google Cloud Console
# Local (via Vite proxy): http://127.0.0.1:5173/api/auth/google/callback
# Render: https://YOUR-SERVICE.onrender.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://127.0.0.1:5173/api/auth/google/callback
# Comma-separated Google emails allowed to sign in
AUTH_ALLOWED_EMAILS=

# Weekly franchisor email report (Gmail SMTP — see docs/WEEKLY_REPORT.md)
REPORT_ENABLED=false
CRON_SECRET=change-me-to-a-long-random-string
GMAIL_USER=atulbakeryhillside@gmail.com
# Google App Password (not your normal Gmail password)
GMAIL_APP_PASSWORD=
REPORT_FROM=atulbakeryhillside@gmail.com
REPORT_TO=franchisor@example.com,owner@example.com
# Optional — defaults to dashboard watch categories if empty
REPORT_CATEGORIES=
